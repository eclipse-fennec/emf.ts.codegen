<%- header %>

<%# Generate imports for referenced types -%>
<%
// GenModel documentation of a model element (class, feature, ...)
function getDocumentation(element) {
  const ann = element?.getEAnnotation?.('http://www.eclipse.org/emf/2002/GenModel');
  const doc = ann?.getDetails?.()?.getByKey?.('documentation');
  return typeof doc === 'string' && doc.length > 0 ? doc : null;
}
// Custom decorator annotations (#31): an eAnnotation source of the form
// '<importable-specifier>/<DecoratorName>' (not an EMF source URI) becomes an
// import plus a decorator application with the details as options object
function getCustomDecorators(element) {
  const decorators = [];
  for (const ann of element?.getEAnnotations?.() ?? []) {
    const source = ann.getSource?.();
    if (!source || source.startsWith('http://') || source.startsWith('https://')) continue;
    const slashIdx = source.lastIndexOf('/');
    if (slashIdx <= 0) continue;
    const name = source.substring(slashIdx + 1);
    if (!/^[A-Za-z_$][A-Za-z0-9_$]*$/.test(name)) continue;
    const options = [];
    for (const entry of ann.getDetails?.() ?? []) {
      const key = entry.eGet?.(entry.eClass().getEStructuralFeature('key'));
      const value = entry.eGet?.(entry.eClass().getEStructuralFeature('value'));
      if (key == null) continue;
      const keyOut = /^[A-Za-z_$][A-Za-z0-9_$]*$/.test(key) ? key : JSON.stringify(key);
      options.push(`${keyOut}: ${JSON.stringify(value ?? '')}`);
    }
    decorators.push({ name, specifier: source.substring(0, slashIdx), options: `{${options.join(', ')}}` });
  }
  return decorators;
}
// Determine which of the annotation decorators the class actually uses (#32)
const classDoc = getDocumentation(eClass);
let usesDocumentation = !!classDoc;
let usesAttribute = false, usesReference = false, usesEnum = false;
for (const genFeature of features) {
  const f = genFeature.ecoreFeature;
  if (getDocumentation(f)) usesDocumentation = true;
  if (f.getEType() && typeMapper.isEEnum(f.getEType())) usesEnum = true;
  else if (typeMapper.isReference(f)) usesReference = true;
  else usesAttribute = true;
}
for (const genOp of operations) {
  if (getDocumentation(genOp.ecoreOperation)) usesDocumentation = true;
}
const annotationNames = [
  ...(usesDocumentation ? ['Documentation'] : []),
  ...(usesAttribute ? ['Attribute'] : []),
  'ModelClass',
  ...(usesReference ? ['Reference'] : []),
  ...(usesEnum ? ['Enum'] : [])
];

// Merge all imports per module specifier: resolved type imports, the used
// annotation decorators, and custom decorator imports (#31, #32)
const mergedImports = new Map();
function addImport(specifier, name) {
  if (!mergedImports.has(specifier)) mergedImports.set(specifier, new Set());
  mergedImports.get(specifier).add(name);
}
const imports = importResolver.resolveImportsForClass(eClass, genPackage, 'decorator');
for (const imp of imports) {
  if (imp.typeName !== className && !imp.typeName.includes(',')) {
    addImport(imp.importPath, imp.typeName);
  }
}
for (const name of annotationNames) addImport(annotationsImport, name);
for (const genOp of operations) {
  for (const dec of getCustomDecorators(genOp.ecoreOperation)) {
    addImport(dec.specifier, dec.name);
  }
}
for (const [specifier, names] of mergedImports) {
-%>
import { <%- [...names].join(', ') %> } from '<%- specifier %>';
<%
}
-%>

<% if (classDoc) { -%>
@Documentation(<%- JSON.stringify(classDoc) %>)
<% } -%>
@ModelClass({ type: '<%- nsURI %>#//<%- className %>' })
export <% if (isAbstract) { %>abstract <% } %>class <%- className %><%
if (typeParameters && typeParameters.length > 0) {
  const params = [];
  for (const tp of typeParameters) {
    params.push(tp.getName());
  }
%><<%- params.join(', ') %>><%
}
if (superTypes && superTypes.length > 0) {
  const superNames = [];
  for (const st of superTypes) {
    // getName helper also resolves the name of an unresolved proxy from its
    // URI fragment - a cross-package supertype must not lose its extends (#30)
    const stName = getName(st);
    if (stName) {
      superNames.push(stName);
    }
  }
  if (superNames.length > 0) {
%> extends <%- superNames[0] %><%
  }
}
%> {
<% for (const genFeature of features) {
  const feature = genFeature.ecoreFeature;
  const featureName = feature.getName();
  const featureType = typeMapper.mapFeatureBaseType(feature);
  // Decorator argument is a runtime type NAME for metadata lookups -
  // generic type arguments must not leak into it (#29). Derived from the
  // mapped type, because an unresolved cross-package eType proxy has no getName
  const decoratorTypeName = featureType.split('<')[0];
  const fullType = typeMapper.mapFeature(feature);
  const defaultValue = typeMapper.getDefaultValue(feature);
  const isMany = feature.isMany();
  const isRef = typeMapper.isReference(feature);
  const isEnum = feature.getEType() && typeMapper.isEEnum(feature.getEType());

  // GenModel documentation as @Documentation decorator; JSON.stringify keeps
  // multiline values and quotes a valid string literal
  const doc = getDocumentation(feature);
  if (doc) {
-%>
  @Documentation(<%- JSON.stringify(doc) %>)
<%
  }
  if (isEnum) {
-%>
  @Enum('<%- decoratorTypeName %>')
<%
  } else if (isRef) {
-%>
  @Reference('<%- decoratorTypeName %>')
<%
  } else {
-%>
  @Attribute()
<%
  }
-%>
  <%- featureName %><% if (!isMany && defaultValue === null) { %>?<% } %>: <%- fullType %><% if (defaultValue !== null) { %> = <%- defaultValue %><% } %>;

<% } -%>
<% for (const genOp of operations) {
  const op = genOp.ecoreOperation;
  const opName = op.getName();
  const returnType = op.getEType() ? typeMapper.mapClassifier(op.getEType()) : 'void';
  const opDoc = getDocumentation(op);
  if (opDoc) {
-%>
  @Documentation(<%- JSON.stringify(opDoc) %>)
<%
  }
  for (const dec of getCustomDecorators(op)) {
-%>
  @<%- dec.name %>(<%- dec.options %>)
<%
  }
-%>
  <%- opName %>(<%- mapParams(op) %>): <%- returnType %> {
    throw new Error('<%- opName %> not implemented');
  }

<% } -%>
}
