<%- header %>

// Package and Factory
export { <%- packageName %>Package } from './<%- packageName %>Package.js';
export { <%- packageName %>Factory } from './<%- packageName %>Factory.js';

// Interfaces
<% for (const genClass of genClasses) {
  const name = getName(genClass.ecoreClass);
-%>
export type { <%- name %> } from './<%- name %>.js';
<% } -%>

// Implementations (including abstract classes, as they're extended by subclasses)
<% for (const genClass of genClasses) {
  if (!checkIsInterface(genClass.ecoreClass)) {
    const implName = genClass.implClassName || (getName(genClass.ecoreClass) + 'Impl');
-%>
export { <%- implName %> } from './<%- implName %>.js';
<%
  }
} -%>

// Enums
<% for (const genEnum of genEnums) {
  const name = getName(genEnum.ecoreEnum);
-%>
export { <%- name %>, get<%- name %>, get<%- name %>ByLiteral } from './<%- name %>.js';
<% } -%>
