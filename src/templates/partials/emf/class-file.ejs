  const needsContainment = features.some(gf => isMany(gf.ecoreFeature) && isContainment(gf.ecoreFeature))
    || (mixinFeatures || []).some(mf => isMany(mf.feature) && isContainment(mf.feature));
  const needsEObjectList = features.some(gf => isMany(gf.ecoreFeature) && !isContainment(gf.ecoreFeature) && typeMapper.isReference(gf.ecoreFeature))
    || (mixinFeatures || []).some(mf => isMany(mf.feature) && !isContainment(mf.feature) && typeMapper.isReference(mf.feature));
  const needsBasicList = features.some(gf => isMany(gf.ecoreFeature) && typeMapper.isAttribute(gf.ecoreFeature))
    || (mixinFeatures || []).some(mf => isMany(mf.feature) && typeMapper.isAttribute(mf.feature));
  if (needsContainment) coreValueImports.push('createContainmentEList');
  if (needsEObjectList) coreValueImports.push('createEObjectEList');
  if (needsBasicList) coreValueImports.push('createBasicEList');
}
for (const imp of imports) {
  if (imp.typeName === className || imp.typeName === interfaceName || imp.typeName === extendsClass) continue;
  if (hardcodedCoreTypes.includes(imp.typeName)) continue;
  if (imp.importPath === '@emfts/core') {
    if (!coreTypeImports.includes(imp.typeName)) {
      coreTypeImports.push(imp.typeName);
    }
    continue;
  }
  // Check if this type is used as a runtime value (e.g., enum default values)
  const usedAsValue = features.some(gf => {
    const dv = typeMapper.getDefaultValue(gf.ecoreFeature);
    return dv !== null && typeof dv === 'string' && dv.startsWith(imp.typeName + '.');
  });
  if (usedAsValue) {
    valueImports.push(imp);
  } else {
    typeOnlyImports.push(imp);
  }
  importedNames.add(imp.typeName);
}
// Add mixin feature type imports (if not already imported)
for (const imp of (mixinImports || [])) {
  if (imp.typeName === className || imp.typeName === interfaceName || imp.typeName === extendsClass) continue;
  if (hardcodedCoreTypes.includes(imp.typeName)) continue;
  if (importedNames.has(imp.typeName)) continue;
  if (imp.importPath === '@emfts/core') {
    if (!coreTypeImports.includes(imp.typeName)) {
      coreTypeImports.push(imp.typeName);
    }
    continue;
  }
  typeOnlyImports.push(imp);
  importedNames.add(imp.typeName);
}
-%>
