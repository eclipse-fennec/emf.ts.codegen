<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="wrapper" nsURI="http://example.org/wrapper" nsPrefix="wrapper">

  <!-- Issue #35: a cross-package reference with a default is instantiated in
       the field initializer - its import must be a value import -->
  <eClassifiers xsi:type="ecore:EClass" name="WrapperSettings">
    <eStructuralFeatures xsi:type="ecore:EReference" name="title" defaultValueLiteral="default"
        eType="http://example.org/base#//Expression"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

</ecore:EPackage>
