<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="ext" nsURI="http://example.org/ext" nsPrefix="ext">

  <!-- Extends Component from base package (cross-package reference) -->
  <eClassifiers xsi:type="ecore:EClass" name="ChartView">
    <eSuperTypes href="http://example.org/base#//Component"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Cross-package reference as feature type -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="filterExpression"
        eType="http://example.org/base#//Expression" containment="true"/>
    <!-- Ecore metaclass type as feature type (tests EStructuralFeature import) -->
    <!-- Uses plain href format (matching real-world uimodel-vega.ecore) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="dataFeature"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature"/>
    <eStructuralFeatures xsi:type="ecore:EReference" upperBound="-1" name="groupBy"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature"/>
  </eClassifiers>

</ecore:EPackage>
