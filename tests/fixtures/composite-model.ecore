<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="composite" nsURI="http://example.org/composite" nsPrefix="composite">

  <!-- Issue #25: cross-package composition via href (eSubpackages + eSuperTypes) -->
  <eSubpackages href="http://example.org/base#/"/>

  <eClassifiers xsi:type="ecore:EClass" name="CompositeComponent">
    <eSuperTypes href="http://example.org/base#//Component"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="version"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

</ecore:EPackage>
