<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="links" nsURI="http://example.org/links" nsPrefix="links">
  <!-- Issue #63: every cardinality combination of a bidirectional reference -->

  <!-- single <-> single -->
  <eClassifiers xsi:type="ecore:EClass" name="Husband">
    <eStructuralFeatures xsi:type="ecore:EReference" name="wife" eType="#//Wife" eOpposite="#//Wife/husband"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Wife">
    <eStructuralFeatures xsi:type="ecore:EReference" name="husband" eType="#//Husband" eOpposite="#//Husband/wife"/>
  </eClassifiers>

  <!-- many <-> many -->
  <eClassifiers xsi:type="ecore:EClass" name="Student">
    <eStructuralFeatures xsi:type="ecore:EReference" name="courses" upperBound="-1" eType="#//Course" eOpposite="#//Course/students"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Course">
    <eStructuralFeatures xsi:type="ecore:EReference" name="students" upperBound="-1" eType="#//Student" eOpposite="#//Student/courses"/>
  </eClassifiers>

  <!-- single containment <-> single (container back reference) -->
  <eClassifiers xsi:type="ecore:EClass" name="Owner">
    <eStructuralFeatures xsi:type="ecore:EReference" name="item" eType="#//Item" containment="true" eOpposite="#//Item/owner"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Item">
    <eStructuralFeatures xsi:type="ecore:EReference" name="owner" eType="#//Owner" eOpposite="#//Owner/item"/>
  </eClassifiers>
</ecore:EPackage>
