<?xml version="1.0" encoding="UTF-8"?>
<ddsr:RemoteServiceRegistry xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:ddsr="http://geckoprojects.org/ddsr/1.0">
  <catalog name="Payment" version="1.0.0" description="Payment processing service">
    <operations name="charge" description="Charge an amount." returnType="double">
      <parameters name="amount" type="double" description="Amount to charge."/>
      <parameters name="currency" index="1" type="string" optional="true" defaultValue="EUR"/>
    </operations>
    <operations name="getBalance" returnType="double">
      <parameters name="accountId" type="string"/>
    </operations>
  </catalog>
  <catalog name="Inventory" version="2.1.0" description="Inventory management">
    <operations name="getStock" description="Get stock count for a product." returnType="int">
      <parameters name="productId" type="string" description="Product identifier"/>
    </operations>
    <operations name="restock" returnType="boolean">
      <parameters name="productId" type="string"/>
      <parameters name="quantity" index="1" type="int"/>
    </operations>
    <operations name="clearAll" description="Clear all inventory."/>
  </catalog>
</ddsr:RemoteServiceRegistry>
